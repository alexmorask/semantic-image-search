# Reference only: nothing loads this file automatically (there is no dotenv).
# Every variable below already has this default in the code; export one to override it.

# Backend (backend/lib/ddb.js, s3.js) and scripts/seed.js
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
TABLE_NAME=images
BUCKET_NAME=images

# Ports: local API (make api) and embedding service (make embed)
PORT=3001
EMBEDDING_PORT=3002

# Set to embed through the embedding service instead of running CLIP in-process.
# deploy.sh sets it for the Lambda; e.g. EMBEDDING_URL=http://localhost:3002 make api
EMBEDDING_URL=

# Bulk loader target (scripts/ingest.js)
API_BASE=http://localhost:3001

# Frontend: API base (make web uses the default; make web-lambda sets /api plus LAMBDA_URL)
VITE_API_BASE=http://localhost:3001
